{
  "name": "@local/dsh-browser-computer-use",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CDP 浏览器控制：插件管理页提供开关与站点权限，Agent 通过 browser-use 技能和 browser 工具使用完整 Chrome DevTools Protocol",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./rpc": "./rpc.js",
    "./cdp": "./cdp.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "package.json",
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "rpc.js",
    "cdp.js",
    "policy.js",
    "launcher.js",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "test/*.test.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cdp",
    "chrome-devtools-protocol",
    "browser-automation"
  ]
}
